<!-- Consumer Specific Fields -->
<input type="text" id="phoneNumber" name="phoneNumber" placeholder="Phone Number" required>
<input type="text" id="consumerStreetAddress" name="consumerStreetAddress" placeholder="Street Address" required>
<input type="text" id="consumerCity" name="consumerCity" placeholder="City" required>
